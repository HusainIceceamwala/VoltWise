# Copy this file to .env and fill in your MySQL credentials to use MySQL instead of SQLite
# Option A: Full URL
# DATABASE_URL=mysql+pymysql://user:password@host:3306/wattwise

# Option B: Individual MySQL vars (the app will build DATABASE_URL automatically)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=wattwise

# If you prefer SQLite, remove or leave these blank and the app will use wattwise.db
s